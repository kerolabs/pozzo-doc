@startuml savings-groups-db
title Savings Groups: esquema savings_groups (PostgreSQL)

skinparam linetype ortho
skinparam shadowing false
skinparam dpi 200
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #305BAB
  ArrowColor #313131
  HeaderBackgroundColor #C6DCFF
}
hide circle
hide empty methods

entity "savings_groups" as groups {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(80)
  * organizer_id : UUID
  * contribution_amount : NUMERIC(12,2)
  * currency : CHAR(3)
  * periodicity : VARCHAR(10)
  * first_contribution_date : DATE
  * cutoff_day : SMALLINT
  * seats : SMALLINT
  destination_method : VARCHAR(10)
  destination_phone : VARCHAR(12)
  turn_method : VARCHAR(10)
  draw_seed : VARCHAR(64)
  turns_assigned_at : TIMESTAMP
  auction_closes_days_before : SMALLINT
  auction_minimum_bid : NUMERIC(12,2)
  auction_fallback : VARCHAR(10)
  * status : VARCHAR(10)
  * created_at : TIMESTAMP
  started_at : TIMESTAMP
}

entity "memberships" as memberships {
  * id : UUID <<PK>>
  --
  * group_id : UUID <<FK>>
  member_id : UUID <<UQ>>
  * display_name : VARCHAR(80)
  phone : VARCHAR(20)
  * kind : VARCHAR(10)
  * status : VARCHAR(12)
  * joined_at : TIMESTAMP
}

entity "invitations" as invitations {
  * id : UUID <<PK>>
  --
  * group_id : UUID <<FK>>
  * code : VARCHAR(8) <<UQ>>
  * created_by : UUID
  * created_at : TIMESTAMP
  * expires_at : TIMESTAMP
  * status : VARCHAR(10)
}

entity "turn_slots" as turn_slots {
  * group_id : UUID <<PK, FK>>
  * turn_number : SMALLINT <<PK>>
  --
  * membership_id : UUID <<FK, UQ>>
  * assigned_by : VARCHAR(10)
}

groups ||--|{ memberships : "tiene"
groups ||--o{ invitations : "invita con"
groups ||--o{ turn_slots : "ordena"
memberships ||--o| turn_slots : "ocupa"
@enduml
