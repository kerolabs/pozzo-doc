@startuml compliance-history-domain
title Compliance History: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #F3FBF6
  BorderColor #067429
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class MemberRecord <<Aggregate Root>> {
    - accountId : UUID
    - entries : List<ComplianceEntry>
    - summary : ComplianceSummary
    - updatedAt : Instant
    + forMember(accountId : UUID, now : Instant) : MemberRecord {static}
    + record(entry : ComplianceEntry, scoring : ComplianceScoringService, now : Instant) : void
    + entriesInCycle(cycleId : UUID) : List<ComplianceEntry>
  }

  class ShareLink <<Aggregate Root>> {
    - id : UUID
    - token : ShareToken
    - accountId : UUID
    - createdAt : Instant
    - expiresAt : Instant
    - revoked : boolean
    + issue(accountId : UUID, now : Instant) : ShareLink {static}
    + isValid(now : Instant) : boolean
    + revoke() : void
  }

  class ComplianceEntry <<Entity>> {
    - id : UUID
    - cycleId : UUID
    - groupId : UUID
    - groupName : String
    - periodId : UUID
    - kind : EntryKind
    - occurredAt : Instant
    - sourceEventId : String
    + of(cycleId, groupId, groupName, periodId, kind, occurredAt, sourceEventId) : ComplianceEntry {static}
    + isNegative() : boolean
  }

  class ComplianceSummary <<Value Object>> {
    - onTime : int
    - late : int
    - covered : int
    - rejected : int
    - dropouts : int
    - cyclesCompleted : int
    - level : ComplianceLevel
    + contributions() : int
    + complianceRate() : Integer
  }
  class ShareToken <<Value Object>> {
    - value : String
    + random() : ShareToken {static}
  }

  enum EntryKind {
    ON_TIME
    LATE
    COVERED
    REJECTED
    DROPOUT
    CYCLE_COMPLETED
  }
  enum ComplianceLevel {
    EXCELLENT
    GOOD
    REGULAR
    RISKY
    NEW
  }

  interface ComplianceScoringService <<Domain Service>> {
    + summarize(entries : List<ComplianceEntry>) : ComplianceSummary
  }

  interface MemberRecordRepository <<Repository>> {
    + findByAccountId(accountId : UUID) : Optional<MemberRecord>
    + existsEntryBySourceEventId(sourceEventId : String) : boolean
    + save(record : MemberRecord) : MemberRecord
  }
  interface ShareLinkRepository <<Repository>> {
    + findByToken(token : ShareToken) : Optional<ShareLink>
    + save(link : ShareLink) : ShareLink
  }

MemberRecord "1" *-- "0..*" ComplianceEntry : entries
MemberRecord "1" *-- "1" ComplianceSummary : summary
MemberRecord "1" o-- "0..*" ShareLink : shared as >
ShareLink "1" *-- "1" ShareToken : token
ComplianceEntry --> EntryKind
ComplianceSummary --> ComplianceLevel
ComplianceScoringService ..> ComplianceSummary : computes
MemberRecordRepository ..> MemberRecord : persists
ShareLinkRepository ..> ShareLink : persists
@enduml
