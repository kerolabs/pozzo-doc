@startuml contributions-domain
title Contributions: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFF7F7
  BorderColor #BD0A0A
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class Cycle <<Aggregate Root>> {
    - id : UUID
    - groupId : UUID
    - groupName : String
    - organizerAccountId : UUID
    - rules : CycleRules
    - turns : List<CycleTurn>
    - currentTurn : int
    - status : CycleStatus
    - startedAt : Instant
    - closedAt : Instant
    + start(groupId, groupName, organizerAccountId, rules, turns, now) : Cycle {static}
    + isOrganizer(accountId : UUID) : boolean
    + participantOf(accountId : UUID) : Optional<CycleTurn>
    + turn(turnNumber : int) : CycleTurn
    + hasRemainingTurns() : boolean
    + advanceToNextTurn() : int
    + replaceMember(droppedMembershipId : UUID, replacement : CycleTurn) : void
    + close(now : Instant) : void
  }

  class Period <<Aggregate Root>> {
    - id : UUID
    - cycleId : UUID
    - turnNumber : int
    - opensAt : LocalDate
    - cutoffDate : LocalDate
    - payoutMembershipId : UUID
    - expected : List<ExpectedContribution>
    - status : PeriodStatus
    - deliveredAt : Instant
    - deliveredBy : UUID
    + open(cycle : Cycle, turnNumber : int, now : Instant) : Period {static}
    + expectedFor(membershipId : UUID) : Optional<ExpectedContribution>
    + settle(membershipId : UUID, how : ExpectedStatus, contributionId : UUID, now : Instant) : void
    + isPotComplete() : boolean
    + collected() : Money
    + potAmount() : Money
    + pendingMembers() : List<ExpectedContribution>
    + deliverPot(organizerAccountId : UUID, now : Instant) : void
  }

  class Contribution <<Aggregate Root>> {
    - id : UUID
    - cycleId : UUID
    - periodId : UUID
    - membershipId : UUID
    - accountId : UUID
    - amount : Money
    - method : ContributionMethod
    - status : ContributionStatus
    - receipt : PaymentReceipt
    - inconsistencies : List<Inconsistency>
    - coveredByMembershipId : UUID
    - registeredByAccountId : UUID
    - review : Review
    - registeredAt : Instant
    + fromReceipt(cycleId, periodId, membershipId, accountId, receipt, expectedAmount, cutoffDate, payeeName, now) : Contribution {static}
    + inCash(cycleId, periodId, membershipId, accountId, amount, receivedOn, cutoffDate, organizerAccountId, now) : Contribution {static}
    + asCoverage(cycleId, periodId, membershipId, accountId, coveredByMembershipId, amount, organizerAccountId, now) : Contribution {static}
    + isUnderReview() : boolean
    + isValid() : boolean
    + approve(organizerAccountId : UUID, note : String, cutoffDate : LocalDate, now : Instant) : void
    + reject(organizerAccountId : UUID, note : String, now : Instant) : void
  }

  class ExpectedContribution <<Entity>> {
    - id : UUID
    - membershipId : UUID
    - amount : Money
    - status : ExpectedStatus
    - settledByContributionId : UUID
    + pendingFor(membershipId : UUID, amount : Money) : ExpectedContribution {static}
    + settle(how : ExpectedStatus, contributionId : UUID) : void
    + isPending() : boolean
    + isLate(today : LocalDate, cutoffDate : LocalDate) : boolean
  }

  class CycleRules <<Value Object>> {
    - contribution : Money
    - periodicity : Periodicity
    - firstContributionDate : LocalDate
    - destinationMethod : String
    - destinationPhone : String
    - payeeName : String
    + cutoffDateOfTurn(turnNumber : int) : LocalDate
    + opensAtOfTurn(turnNumber : int) : LocalDate
    + cutoffDay() : int
  }
  class CycleTurn <<Value Object>> {
    - turnNumber : int
    - membershipId : UUID
    - accountId : UUID
    - displayName : String
    + belongsTo(accountId : UUID) : boolean
  }
  class PaymentReceipt <<Value Object>> {
    - operationNumber : String
    - payerName : String
    - payeeName : String
    - amount : Money
    - paidAt : LocalDate
    - source : ReceiptSource
    + matchesPayee(expectedName : String) : boolean
  }
  class Inconsistency <<Value Object>> {
    - field : String
    - expected : String
    - found : String
  }
  class Review <<Value Object>> {
    - reviewerAccountId : UUID
    - decision : ReviewDecision
    - note : String
    - reviewedAt : Instant
  }
  class Money <<Value Object>> {
    - amount : BigDecimal
    - currency : String
    + plus(other : Money) : Money
    + times(times : int) : Money
    + isSameAmountAs(other : Money) : boolean
  }

  enum CycleStatus {
    ACTIVE
    CLOSED
  }
  enum PeriodStatus {
    OPEN
    POT_COMPLETE
    DELIVERED
  }
  enum ContributionStatus {
    VALIDATED
    INCONSISTENT
    APPROVED
    REJECTED
  }
  enum ContributionMethod {
    TRANSFER
    CASH
    COVERAGE
  }
  enum ExpectedStatus {
    PENDING
    PAID
    COVERED
  }
  enum ReviewDecision {
    APPROVE
    REJECT
  }
  enum Periodicity {
    WEEKLY
    BIWEEKLY
    MONTHLY
  }
  enum ReceiptSource {
    YAPE
    PLIN
    BANK
  }

  interface CycleRepository <<Repository>> {
    + findById(id : UUID) : Optional<Cycle>
    + findByGroupId(groupId : UUID) : Optional<Cycle>
    + existsByGroupId(groupId : UUID) : boolean
    + save(cycle : Cycle) : Cycle
  }
  interface PeriodRepository <<Repository>> {
    + findById(id : UUID) : Optional<Period>
    + findByCycleIdAndTurnNumber(cycleId : UUID, turnNumber : int) : Optional<Period>
    + findAllByCycleId(cycleId : UUID) : List<Period>
    + save(period : Period) : Period
  }
  interface ContributionRepository <<Repository>> {
    + findById(id : UUID) : Optional<Contribution>
    + findAllByPeriodId(periodId : UUID) : List<Contribution>
    + findAllByCycleIdAndMembershipId(cycleId : UUID, membershipId : UUID) : List<Contribution>
    + existsByCycleIdAndOperationNumber(cycleId : UUID, operationNumber : String) : boolean
    + save(contribution : Contribution) : Contribution
  }

Cycle "1" *-- "1" CycleRules : rules
Cycle "1" *-- "2..*" CycleTurn : turns
Cycle "1" o-- "1..*" Period : periods >
Period "1" *-- "1..*" ExpectedContribution : expected
Period "1" o-- "0..*" Contribution : contributions >
Contribution "1" *-- "0..1" PaymentReceipt : receipt
Contribution "1" *-- "0..*" Inconsistency : inconsistencies
Contribution "1" *-- "0..1" Review : review
Contribution --> Money
ExpectedContribution --> Money
PaymentReceipt --> Money
CycleRules --> Money
CycleRules --> Periodicity
PaymentReceipt --> ReceiptSource
Review --> ReviewDecision
Cycle --> CycleStatus
Period --> PeriodStatus
Contribution --> ContributionStatus
Contribution --> ContributionMethod
ExpectedContribution --> ExpectedStatus

CycleRepository ..> Cycle : persists
PeriodRepository ..> Period : persists
ContributionRepository ..> Contribution : persists
@enduml
