@startuml contributions-domain
title Contributions: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFF7F7
  BorderColor #BD0A0A
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class Cycle <<Aggregate Root>> {
    - id : UUID
    - groupId : UUID
    - groupName : String
    - organizerAccountId : UUID
    - rules : CycleRules
    - turns : List<CycleTurn>
    - currentTurn : int
    - status : CycleStatus
    - startedAt : Instant
    - closedAt : Instant
    - auctionSettings : AuctionSettings
    + start(groupId, groupName, organizerAccountId, rules, turns, auctionSettings, now) : Cycle {static}
    + isOrganizer(accountId : UUID) : boolean
    + participantOf(accountId : UUID) : Optional<CycleTurn>
    + turn(turnNumber : int) : CycleTurn
    + hasRemainingTurns() : boolean
    + advanceToNextTurn() : int
    + linkAccount(membershipId : UUID, accountId : UUID, now : Instant) : boolean
    + swapTurns(firstMembershipId : UUID, secondMembershipId : UUID, now : Instant) : void
    + registerDropout(membershipId : UUID, now : Instant) : void
    + replaceMember(droppedMembershipId, replacementMembershipId, accountId, displayName, currentPotDelivered) : CycleTurn
    + isAuction() : boolean
    + stillToCollect() : List<CycleTurn>
    + giveCurrentTurnTo(winnerMembershipId : UUID) : void
    + close(now : Instant) : void
  }

  class Period <<Aggregate Root>> {
    - id : UUID
    - cycleId : UUID
    - turnNumber : int
    - opensAt : LocalDate
    - cutoffDate : LocalDate
    - payoutMembershipId : UUID
    - expected : List<ExpectedContribution>
    - status : PeriodStatus
    - deliveredAt : Instant
    - deliveredBy : UUID
    - payoutProofPath : String
    - discount : Money
    + open(cycle : Cycle, turnNumber : int, credits : Map<UUID, Money>, now : Instant) : Period {static}
    + expectedFor(membershipId : UUID) : Optional<ExpectedContribution>
    + settle(membershipId : UUID, how : ExpectedStatus, contributionId : UUID, now : Instant) : void
    + isPotComplete() : boolean
    + collected() : Money
    + potAmount() : Money
    + pendingMembers() : List<ExpectedContribution>
    + deliverPot(organizerAccountId : UUID, now : Instant) : void
    + attachPayoutProof(path : String) : void
    + reassignMember(droppedMembershipId : UUID, replacementMembershipId : UUID) : void
    + applyAuctionResult(winnerMembershipId : UUID, discount : Money) : void
    + payoutAmount() : Money
  }

  class Contribution <<Aggregate Root>> {
    - id : UUID
    - cycleId : UUID
    - periodId : UUID
    - membershipId : UUID
    - accountId : UUID
    - amount : Money
    - method : ContributionMethod
    - status : ContributionStatus
    - receipt : PaymentReceipt
    - inconsistencies : List<Inconsistency>
    - coveredByMembershipId : UUID
    - registeredByAccountId : UUID
    - review : Review
    - receiptImagePath : String
    - receivedOn : LocalDate
    - verificationToken : VerificationToken
    - registeredAt : Instant
    + fromReceipt(cycleId, periodId, membershipId, accountId, receipt, expectedAmount, cutoffDate, payeeName, now) : Contribution {static}
    + inCash(cycleId, periodId, membershipId, accountId, amount, receivedOn, cutoffDate, organizerAccountId, now) : Contribution {static}
    + asCoverage(cycleId, periodId, membershipId, accountId, coveredByMembershipId, amount, organizerAccountId, now) : Contribution {static}
    + isUnderReview() : boolean
    + isValid() : boolean
    + approve(organizerAccountId : UUID, note : String, cutoffDate : LocalDate, now : Instant) : void
    + reject(organizerAccountId : UUID, note : String, now : Instant) : void
    + attachReceiptImage(path : String) : void
    + isSettled() : boolean
    + arrivedBy(cutoffDate : LocalDate, zone : ZoneId) : boolean
    + shareVerifiably() : VerificationToken
  }

  class Auction <<Aggregate Root>> {
    - id : UUID
    - cycleId : UUID
    - periodId : UUID
    - turnNumber : int
    - closesOn : LocalDate
    - minimumBid : Money
    - potAmount : Money
    - fallback : AuctionFallback
    - status : AuctionStatus
    - bids : List<Bid>
    - winnerMembershipId : UUID
    - discount : Money
    - creditPerMember : Money
    - resolution : AuctionResolution
    - closedAt : Instant
    + open(cycle : Cycle, period : Period, now : Instant) : Auction {static}
    + placeBid(membershipId : UUID, amount : Money, eligible : Collection<UUID>, today : LocalDate, now : Instant) : void
    + highestBid() : Optional<Bid>
    + rankedBids() : List<Bid>
    + close(winnerMembershipId : UUID, resolution : AuctionResolution, othersStillToCollect : int, now : Instant) : void
    + isDue(today : LocalDate) : boolean
  }

  class ExpectedContribution <<Entity>> {
    - id : UUID
    - membershipId : UUID
    - amount : Money
    - status : ExpectedStatus
    - settledByContributionId : UUID
    + pendingFor(membershipId : UUID, amount : Money) : ExpectedContribution {static}
    + settle(how : ExpectedStatus, contributionId : UUID) : void
    + transferTo(membershipId : UUID) : void
    + isPending() : boolean
    + isLate(today : LocalDate, cutoffDate : LocalDate) : boolean
  }

  class CycleRules <<Value Object>> {
    - contribution : Money
    - periodicity : Periodicity
    - firstContributionDate : LocalDate
    - destinationMethod : String
    - destinationPhone : String
    - payeeName : String
    + cutoffDateOfTurn(turnNumber : int) : LocalDate
    + opensAtOfTurn(turnNumber : int) : LocalDate
    + cutoffDay() : int
  }
  class CycleTurn <<Value Object>> {
    - turnNumber : int
    - membershipId : UUID
    - accountId : UUID
    - displayName : String
    + belongsTo(accountId : UUID) : boolean
  }
  class AuctionSettings <<Value Object>> {
    - closesDaysBeforeCutoff : int
    - minimumBid : Money
    - fallback : AuctionFallback
  }
  class Bid <<Value Object>> {
    - membershipId : UUID
    - amount : Money
    - placedAt : Instant
  }
  class VerificationToken <<Value Object>> {
    - value : String
    + random() : VerificationToken {static}
  }
  class PaymentReceipt <<Value Object>> {
    - operationNumber : String
    - payerName : String
    - payeeName : String
    - amount : Money
    - paidAt : LocalDate
    - source : ReceiptSource
    + matchesPayee(expectedName : String) : boolean
  }
  class Inconsistency <<Value Object>> {
    - field : String
    - expected : String
    - found : String
  }
  class Review <<Value Object>> {
    - reviewerAccountId : UUID
    - decision : ReviewDecision
    - note : String
    - reviewedAt : Instant
  }
  class Money <<Value Object>> {
    - amount : BigDecimal
    - currency : String
    + plus(other : Money) : Money
    + times(times : int) : Money
    + isSameAmountAs(other : Money) : boolean
  }

  enum CycleStatus {
    ACTIVE
    CLOSED
  }
  enum PeriodStatus {
    OPEN
    POT_COMPLETE
    DELIVERED
  }
  enum ContributionStatus {
    VALIDATED
    INCONSISTENT
    APPROVED
    REJECTED
  }
  enum ContributionMethod {
    TRANSFER
    CASH
    COVERAGE
  }
  enum ExpectedStatus {
    PENDING
    PAID
    COVERED
  }
  enum ReviewDecision {
    APPROVE
    REJECT
  }
  enum Periodicity {
    WEEKLY
    BIWEEKLY
    MONTHLY
  }
  enum ReceiptSource {
    YAPE
    PLIN
    BANK
  }
  enum AuctionStatus {
    OPEN
    CLOSED
  }
  enum AuctionFallback {
    DRAW
    ORGANIZER
  }
  enum AuctionResolution {
    BID
    DRAW
    ORGANIZER
  }

  interface CycleRepository <<Repository>> {
    + findById(id : UUID) : Optional<Cycle>
    + findByGroupId(groupId : UUID) : Optional<Cycle>
    + existsByGroupId(groupId : UUID) : boolean
    + save(cycle : Cycle) : Cycle
  }
  interface PeriodRepository <<Repository>> {
    + findById(id : UUID) : Optional<Period>
    + findByCycleIdAndTurnNumber(cycleId : UUID, turnNumber : int) : Optional<Period>
    + findAllByCycleId(cycleId : UUID) : List<Period>
    + save(period : Period) : Period
  }
  interface ContributionRepository <<Repository>> {
    + findById(id : UUID) : Optional<Contribution>
    + findAllByPeriodId(periodId : UUID) : List<Contribution>
    + findAllByCycleIdAndMembershipId(cycleId : UUID, membershipId : UUID) : List<Contribution>
    + existsByCycleIdAndOperationNumber(cycleId : UUID, operationNumber : String) : boolean
    + findByVerificationToken(token : String) : Optional<Contribution>
    + save(contribution : Contribution) : Contribution
  }
  interface AuctionRepository <<Repository>> {
    + findByPeriodId(periodId : UUID) : Optional<Auction>
    + findAllOpen() : List<Auction>
    + save(auction : Auction) : Auction
  }

Cycle "1" *-- "1" CycleRules : rules
Cycle "1" *-- "2..*" CycleTurn : turns
Cycle "1" o-- "1..*" Period : periods >
Period "1" *-- "1..*" ExpectedContribution : expected
Period "1" o-- "0..*" Contribution : contributions >
Contribution "1" *-- "0..1" PaymentReceipt : receipt
Contribution "1" *-- "0..*" Inconsistency : inconsistencies
Contribution "1" *-- "0..1" Review : review
Contribution "1" *-- "0..1" VerificationToken : verificationToken
Cycle "1" *-- "0..1" AuctionSettings : auctionSettings
Period "1" o-- "0..1" Auction : auction >
Auction "1" *-- "0..*" Bid : bids
AuctionSettings --> AuctionFallback
Auction --> AuctionStatus
Auction --> AuctionResolution
Bid --> Money
Contribution --> Money
ExpectedContribution --> Money
PaymentReceipt --> Money
CycleRules --> Money
CycleRules --> Periodicity
PaymentReceipt --> ReceiptSource
Review --> ReviewDecision
Cycle --> CycleStatus
Period --> PeriodStatus
Contribution --> ContributionStatus
Contribution --> ContributionMethod
ExpectedContribution --> ExpectedStatus

CycleRepository ..> Cycle : persists
PeriodRepository ..> Period : persists
ContributionRepository ..> Contribution : persists
AuctionRepository ..> Auction : persists
@enduml
