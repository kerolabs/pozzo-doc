@startuml identity-access-domain
title Identity & Access: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #595959
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class Account <<Aggregate Root>> {
    - id : UUID
    - phoneNumber : PhoneNumber
    - profile : Profile
    - termsAcceptedAt : Instant
    - status : AccountStatus
    + register(phoneNumber : PhoneNumber, profile : Profile, termsAccepted : boolean, now : Instant) : Account {static}
    + updateProfile(profile : Profile, now : Instant) : void
    + hasAcceptedTerms() : boolean
    + isActive() : boolean
    + deactivate() : void
  }

  class VerificationCode <<Aggregate Root>> {
    - id : UUID
    - phoneNumber : PhoneNumber
    - codeHash : String
    - issuedAt : Instant
    - expiresAt : Instant
    - attempts : int
    - status : VerificationStatus
    + issue(phoneNumber : PhoneNumber, codeHash : String, now : Instant) : VerificationCode {static}
    + verify(input : String, now : Instant, matcher : CodeMatcher) : VerificationOutcome
    + invalidate() : void
    + isExpired(now : Instant) : boolean
    + remainingAttempts() : int
    + resendAvailableAt() : Instant
    + canBeReplacedAt(now : Instant) : boolean
  }

  class Session <<Aggregate Root>> {
    - id : UUID
    - accountId : UUID
    - tokenHash : String
    - deviceLabel : String
    - issuedAt : Instant
    - expiresAt : Instant
    - revokedAt : Instant
    + open(id : UUID, accountId : UUID, tokenHash : String, deviceLabel : String, now : Instant) : Session {static}
    + isActive(now : Instant) : boolean
    + revoke(now : Instant) : void
  }

  class PhoneNumber <<Value Object>> {
    - countryCode : String
    - number : String
    + e164() : String
    + isPeruvianMobile() : boolean
  }
  class Profile <<Value Object>> {
    - displayName : String
    - photoUrl : String
    - theme : Theme
  }
  class SessionTokenClaims <<Value Object>> {
    - accountId : UUID
    - sessionId : UUID
  }

  enum AccountStatus {
    ACTIVE
    DEACTIVATED
  }
  enum VerificationStatus {
    PENDING
    VERIFIED
    EXPIRED
    BLOCKED
  }
  enum VerificationOutcome {
    VERIFIED
    INVALID
    EXPIRED
    BLOCKED
  }
  enum Theme {
    SYSTEM
    LIGHT
    DARK
  }

  interface CodeGenerationService <<Domain Service>> {
    + generate() : String
    + hash(code : String) : String
    + matches(code : String, hash : String) : boolean
  }
  interface CodeMatcher <<Domain Service>> {
    + matches(input : String) : boolean
  }
  interface TokenService <<Domain Service>> {
    + issueSessionToken(claims : SessionTokenClaims, issuedAt : Instant, expiresAt : Instant) : String
    + issueRegistrationToken(phoneNumber : PhoneNumber, issuedAt : Instant, expiresAt : Instant) : String
    + readSessionToken(token : String) : Optional<SessionTokenClaims>
    + readRegistrationToken(token : String) : Optional<PhoneNumber>
    + hash(token : String) : String
  }

  interface AccountRepository <<Repository>> {
    + findById(id : UUID) : Optional<Account>
    + findByPhoneNumber(phoneNumber : PhoneNumber) : Optional<Account>
    + existsByPhoneNumber(phoneNumber : PhoneNumber) : boolean
    + save(account : Account) : Account
  }
  interface VerificationCodeRepository <<Repository>> {
    + findLatestByPhoneNumber(phoneNumber : PhoneNumber) : Optional<VerificationCode>
    + findPendingByPhoneNumber(phoneNumber : PhoneNumber) : Optional<VerificationCode>
    + findAllPendingByPhoneNumber(phoneNumber : PhoneNumber) : List<VerificationCode>
    + save(verificationCode : VerificationCode) : VerificationCode
  }
  interface SessionRepository <<Repository>> {
    + findById(id : UUID) : Optional<Session>
    + findByTokenHash(tokenHash : String) : Optional<Session>
    + save(session : Session) : Session
  }

Account "1" *-- "1" PhoneNumber : phoneNumber
Account "1" *-- "1" Profile : profile
Account "1" o-- "0..*" Session : sessions >
VerificationCode "1" *-- "1" PhoneNumber : phoneNumber
Account --> AccountStatus
VerificationCode --> VerificationStatus
VerificationCode ..> VerificationOutcome : returns
VerificationCode ..> CodeMatcher : uses
Profile --> Theme
CodeGenerationService ..> VerificationCode : issues and checks
TokenService ..> SessionTokenClaims : reads and writes
TokenService ..> Session : issues tokens
AccountRepository ..> Account : persists
VerificationCodeRepository ..> VerificationCode : persists
SessionRepository ..> Session : persists
@enduml
