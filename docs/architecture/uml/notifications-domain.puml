@startuml notifications-domain
title Notifications: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #F7F5FF
  BorderColor #6631D7
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class Device <<Aggregate Root>> {
    - id : UUID
    - accountId : UUID
    - pushToken : String
    - platform : Platform
    - registeredAt : Instant
    - active : boolean
    + register(accountId : UUID, pushToken : String, platform : Platform, now : Instant) : Device {static}
    + assignTo(accountId : UUID, platform : Platform, now : Instant) : void
    + deactivate() : void
  }

  class ReminderPlan <<Aggregate Root>> {
    - id : UUID
    - groupId : UUID
    - offsetsInDays : List<Integer>
    - sendHour : int
    - enabled : boolean
    - updatedAt : Instant
    + defaultFor(groupId : UUID, now : Instant) : ReminderPlan {static}
    + configure(offsets : List<Integer>, sendHour : int, enabled : boolean, now : Instant) : void
    + scheduleFor(cutoffDate : LocalDate, zone : ZoneId) : Map<Integer, Instant>
  }

  class Notification <<Aggregate Root>> {
    - id : UUID
    - accountId : UUID
    - groupId : UUID
    - periodId : UUID
    - kind : NotificationKind
    - content : NotificationContent
    - dedupKey : String
    - scheduledAt : Instant
    - sentAt : Instant
    - status : NotificationStatus
    - attempts : int
    + reminder(accountId, groupId, periodId, content, dedupKey, scheduledAt) : Notification {static}
    + alert(accountId, groupId, periodId, content, dedupKey, now) : Notification {static}
    + isDue(now : Instant) : boolean
    + markSent(now : Instant) : void
    + markFailed() : void
    + cancel() : void
  }

  class NotificationContent <<Value Object>> {
    - title : String
    - body : String
    - deepLink : String
  }

  enum NotificationKind {
    REMINDER
    ALERT
  }
  enum NotificationStatus {
    SCHEDULED
    SENT
    CANCELLED
    FAILED
  }
  enum Platform {
    ANDROID
    IOS
  }

  interface DeviceRepository <<Repository>> {
    + findById(id : UUID) : Optional<Device>
    + findByPushToken(pushToken : String) : Optional<Device>
    + findActiveByAccountId(accountId : UUID) : List<Device>
    + save(device : Device) : Device
  }
  interface ReminderPlanRepository <<Repository>> {
    + findByGroupId(groupId : UUID) : Optional<ReminderPlan>
    + save(plan : ReminderPlan) : ReminderPlan
  }
  interface NotificationRepository <<Repository>> {
    + findDue(now : Instant, limit : int) : List<Notification>
    + findScheduledRemindersByPeriodIdAndAccountId(periodId : UUID, accountId : UUID) : List<Notification>
    + existsByDedupKey(dedupKey : String) : boolean
    + findSentByAccountId(accountId : UUID, limit : int) : List<Notification>
    + save(notification : Notification) : Notification
  }

Device --> Platform
Notification "1" *-- "1" NotificationContent : content
Notification --> NotificationKind
Notification --> NotificationStatus
ReminderPlan ..> Notification : schedules
DeviceRepository ..> Device : persists
ReminderPlanRepository ..> ReminderPlan : persists
NotificationRepository ..> Notification : persists
@enduml
