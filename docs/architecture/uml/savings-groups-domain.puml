@startuml savings-groups-domain
title Savings Groups: Domain Layer

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam class {
  BackgroundColor #F5F9FF
  BorderColor #305BAB
  ArrowColor #313131
}
skinparam enum {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #8A8A7E
}
hide empty members

  class SavingsGroup <<Aggregate Root>> {
    - id : UUID
    - name : String
    - organizerId : UUID
    - rules : GroupRules
    - memberships : List<Membership>
    - turns : List<TurnSlot>
    - turnMethod : TurnMethod
    - drawSeed : String
    - turnsAssignedAt : Instant
    - auctionRules : AuctionRules
    - status : GroupStatus
    - createdAt : Instant
    - startedAt : Instant
    + create(organizerId, organizerName, name, rules, now) : SavingsGroup {static}
    + updateRules(name : String, rules : GroupRules) : void
    + defineDestination(destination : Destination) : void
    + join(memberId : UUID, displayName : String, now : Instant) : Membership
    + addManualMember(displayName : String, phone : String, now : Instant) : Membership
    + removeMember(membershipId : UUID, now : Instant) : void
    + assignTurns(slots : List<TurnSlot>, method : TurnMethod, seed : String, now : Instant) : void
    + assignTurnsByAuction(rules : AuctionRules, now : Instant) : void
    + hasFreeSeats() : boolean
    + canStart() : boolean
    + start(now : Instant) : void
    + linkManualMember(phone : String, accountId : UUID, now : Instant) : Optional<Membership>
    + applySwappedTurns(firstMembershipId, firstTurn, secondMembershipId, secondTurn) : void
    + registerDropout(membershipId : UUID, now : Instant) : Membership
    + replaceDroppedMember(droppedMembershipId, accountId, displayName, phone, now) : Membership
    + openNewCycle(firstContributionDate : LocalDate, now : Instant) : SavingsGroup
    + turnCalendar() : List<TurnSlot>
  }

  class Invitation <<Aggregate Root>> {
    - id : UUID
    - groupId : UUID
    - code : InvitationCode
    - createdBy : UUID
    - createdAt : Instant
    - expiresAt : Instant
    - status : InvitationStatus
    + generate(groupId : UUID, organizerId : UUID, code : InvitationCode, now : Instant) : Invitation {static}
    + isUsable(now : Instant) : boolean
    + expire() : void
  }

  class Membership <<Entity>> {
    - id : UUID
    - memberId : UUID
    - displayName : String
    - phone : String
    - kind : MembershipKind
    - status : MembershipStatus
    - joinedAt : Instant
    + ofAppMember(memberId, displayName, now) : Membership {static}
    + ofManualMember(displayName, phone, now) : Membership {static}
    + ofReplacement(memberId, displayName, phone, now) : Membership {static}
    + isActive() : boolean
    + belongsTo(accountId : UUID) : boolean
    + linkAccount(accountId : UUID) : void
    + remove() : void
    + markDropped() : void
  }

  class GroupRules <<Value Object>> {
    - contribution : Money
    - periodicity : Periodicity
    - seats : int
    - firstContributionDate : LocalDate
    - destination : Destination
    + withDestination(destination : Destination) : GroupRules
    + pot() : Money
    + cutoffDay() : int
    + cutoffDateOfTurn(turnNumber : int) : LocalDate
  }
  class AuctionRules <<Value Object>> {
    - closesDaysBeforeCutoff : int
    - minimumBid : Money
    - fallback : AuctionFallback
  }
  class TurnSlot <<Value Object>> {
    - turnNumber : int
    - membershipId : UUID
    - assignedBy : TurnMethod
  }
  class InvitationCode <<Value Object>> {
    - value : String
    + random() : InvitationCode {static}
  }
  class Destination <<Value Object>> {
    - method : PaymentMethod
    - phoneNumber : String
  }
  class Money <<Value Object>> {
    - amount : BigDecimal
    - currency : String
  }

  enum GroupStatus {
    DRAFT
    READY
    STARTED
    CLOSED
  }
  enum MembershipKind {
    APP
    MANUAL
  }
  enum MembershipStatus {
    ACTIVE
    REMOVED
    DROPPED
    REPLACEMENT
  }
  enum TurnMethod {
    DRAW
    AGREED
    AUCTION
  }
  enum InvitationStatus {
    ACTIVE
    EXPIRED
  }
  enum PaymentMethod {
    YAPE
    PLIN
  }
  enum AuctionFallback {
    DRAW
    ORGANIZER
  }
  enum Periodicity {
    WEEKLY
    BIWEEKLY
    MONTHLY
  }

  interface TurnAssignmentService <<Domain Service>> {
    + drawTurns(group : SavingsGroup, seed : String) : List<TurnSlot>
    + agreedTurns(group : SavingsGroup, order : List<UUID>) : List<TurnSlot>
  }

  interface SavingsGroupRepository <<Repository>> {
    + findById(id : UUID) : Optional<SavingsGroup>
    + findAllByMemberId(memberId : UUID) : List<SavingsGroup>
    + findAllWithUnlinkedManualMember(phone : String) : List<SavingsGroup>
    + save(group : SavingsGroup) : SavingsGroup
  }
  interface InvitationRepository <<Repository>> {
    + findByCode(code : InvitationCode) : Optional<Invitation>
    + existsByCode(code : InvitationCode) : boolean
    + findAllActiveByGroupId(groupId : UUID) : List<Invitation>
    + save(invitation : Invitation) : Invitation
  }

SavingsGroup "1" *-- "1" GroupRules : rules
SavingsGroup "1" *-- "1..*" Membership : memberships
SavingsGroup "1" *-- "0..*" TurnSlot : turns
SavingsGroup "1" o-- "0..*" Invitation : invitations >
SavingsGroup "1" *-- "0..1" AuctionRules : auctionRules
Invitation "1" *-- "1" InvitationCode : code
GroupRules "1" *-- "0..1" Destination : destination
Destination --> PaymentMethod
AuctionRules --> Money
AuctionRules --> AuctionFallback
GroupRules --> Money
GroupRules --> Periodicity
SavingsGroup --> GroupStatus
SavingsGroup --> TurnMethod
Membership --> MembershipKind
Membership --> MembershipStatus
Invitation --> InvitationStatus

SavingsGroupRepository ..> SavingsGroup : persists
InvitationRepository ..> Invitation : persists
TurnAssignmentService ..> SavingsGroup : assigns turns
@enduml
