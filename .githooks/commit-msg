#!/bin/sh
# Rejects commits that credit an AI tool as an author.
# Enabled with:  git config core.hooksPath .githooks
# dependencies.ps1 does this for you.

message="$1"

coauthor='^[[:space:]]*Co-authored-by:.*(claude|copilot|chatgpt|openai|anthropic|gemini|cursor|codeium|devin|tabnine)'
signature='(Generated with|Co-Authored-By).*(Claude|Copilot|ChatGPT|Gemini|Cursor)'

if grep -qiE "$coauthor" "$message" || grep -qE "$signature" "$message" || grep -q '🤖' "$message"; then
  echo ""
  echo "COMMIT REJECTED: the message credits an AI tool as an author."
  echo ""
  echo "Offending lines:"
  grep -inE "$coauthor|$signature|🤖" "$message" | sed 's/^/  /'
  echo ""
  echo "This course is graded individually and the commit history is part of"
  echo "the evidence. Remove those lines from the message."
  echo ""
  exit 1
fi

exit 0
